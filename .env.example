# Required: Azure OpenAI resource key; replace this placeholder locally.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# Required: resource endpoint without /openai/v1/ (the backend appends it).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Optional: legacy key alias, used only when AZURE_OPENAI_API_KEY is unset/empty.
# AZURE_OPENAI_KEY=your-azure-openai-api-key
# Optional: Azure chat deployment name; default shown.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
# Optional: Azure embedding deployment name; default shown.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Optional: RAGAS judge deployment; unset uses the configured chat deployment.
# RAGAS_EVALUATOR_MODEL=your-evaluator-deployment
# Optional: positive question limit for evaluate_ragas; unset evaluates all records.
# RAGAS_EVALUATION_LIMIT=5
# Optional: HTTP user agent used by the standalone web-loading examples.
USER_AGENT=Grounded/1.0
# Frontend only: set in frontend/.env; Vite does not read this root file.
# VITE_API_BASE_URL=http://127.0.0.1:8000
